# Скопируй в .env для локального запуска.
# Для GitHub Actions — все эти значения идут в Secrets/Variables репозитория.
# Никогда не коммить .env с реальными значениями!

# ── Твой проект (обязательно, если это не оригинальный BLD System) ───────────
# Какие репозитории наблюдает и обсуждает AI-команда. Формат:
#   имя1=github.com/владелец/репо1.git,имя2=github.com/владелец/репо2.git
# Можно один репозиторий, можно несколько. "Имя" — произвольный короткий
# идентификатор, используется как имя папки в ./repos.
# Если не задано — ai-team обсуждает сам себя (этот репозиторий) — рабочее
# демо без какой-либо настройки.
TARGET_REPOS=

# ── Модели ─────────────────────────────────────────────────────────────────
# MODEL_PROVIDER=openai (дефолт) — любой OpenAI-совместимый API:
#   сам api.openai.com, или OpenRouter/Groq/Together/локальный vLLM/Ollama —
#   всё, что говорит на Chat Completions API. Самый низкий порог входа.
# MODEL_PROVIDER=azure_foundry — настройка автора форка (см. ниже).
MODEL_PROVIDER=openai

# Нужен для MODEL_PROVIDER=openai. Обычный ключ с platform.openai.com,
# либо ключ любого другого OpenAI-совместимого провайдера.
OPENAI_API_KEY=

# Нужен, только если ключ выше — НЕ от самого OpenAI (например,
# OpenRouter: https://openrouter.ai/api/v1). Оставь пустым для api.openai.com.
OPENAI_BASE_URL=

# Дефолты моделей для основной четвёрки (CTO/Backend/Product/QA) + модератор +
# code_scout уже дешёвые (gpt-5.4-mini/nano) — см. config/models.py.
# Переопределить любую роль — своей переменной, без правки кода:
# MODEL_CTO=gpt-5.4
# MODEL_BACKEND=gpt-5.4
# MODEL_PRODUCT=gpt-5.4-nano
# MODEL_QA=gpt-5.4
# MODEL_CODE_SCOUT=gpt-5.4-mini
# MODEL_MODERATOR=gpt-5.4-nano

# ── Добавить/убрать участников дискуссии без правки кода ────────────────────
# Убрать кого-то из встроенной четвёрки:
# DISABLE_ROLES=product_frontend,qa_security
#
# Добавить новых — не через .env, а через config/custom_agents.yaml
# (скопируй config/custom_agents.yaml.example и опиши агента — см. файл).

# ── GitHub ────────────────────────────────────────────────────────────────────
# Нужен ТОЛЬКО если репозитории из TARGET_REPOS приватные.
# Для публичных open-source репозиториев — не нужен вообще.
GITHUB_TOKEN=

# ── Telegram (опционально) ───────────────────────────────────────────────────
# 1. Создай бота: напиши @BotFather → /newbot → получишь токен
# 2. Напиши своему боту любое сообщение (иначе он не сможет тебе писать)
# 3. Открой в браузере: https://api.telegram.org/bot<TOKEN>/getUpdates
#    Найди "chat":{"id": ...} — это твой chat_id
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ── Прочее ────────────────────────────────────────────────────────────────────
AI_TEAM_WORKDIR=./repos

# ══════════════════════════════════════════════════════════════════════════
# Всё ниже — только для MODEL_PROVIDER=azure_foundry (настройка автора
# этого форка). Если ты используешь MODEL_PROVIDER=openai (дефолт),
# можешь пропустить весь этот раздел.
# ══════════════════════════════════════════════════════════════════════════

# Project endpoint (не resource endpoint!):
# Azure AI Foundry → твой проект → Overview → "Project endpoint"
FOUNDRY_PROJECT_ENDPOINT=

# Аутентификация:
# Локально: просто выполни `az login` — DefaultAzureCredential подхватит сам,
#           переменные ниже не нужны.
# GitHub Actions: нужен Service Principal (см. README — раздел GitHub Actions).
AZURE_CLIENT_ID=
AZURE_TENANT_ID=
AZURE_CLIENT_SECRET=

# Нужен для моделей не из линейки gpt-*/o-серии (DeepSeek/Grok/Kimi/Mistral
# и т.п.) через Azure AI Model Inference API — используются в расширенных
# режимах (совет директоров, правление, Global Elite и т.д.).
AZURE_AI_INFERENCE_KEY=

# ── Модели совета директоров / правления / расширенного ростера (опционально) ─
# Если не задано — берутся Azure-дефолты из config/models.py. Эти роли
# (~200 участников) не были адаптированы под MODEL_PROVIDER=openai — если
# запускаешь эти режимы без Azure, переопредели нужные тебе роли моделями,
# доступными на твоём провайдере.
# MODEL_BOARD_MEKHMAT=o3
# MODEL_BOARD_FIZTECH=gpt-5.1
# MODEL_BOARD_FIZMAT=o3
# MODEL_BOARD_TEHMAT=gpt-5.1
# MODEL_BOARD_SECRETARY=gpt-5.4-mini
# MODEL_BOARD_AGENDA=gpt-5.4-mini
# MODEL_EXEC_SALES=grok-4.3
# MODEL_EXEC_MARKETING=DeepSeek-V4-Pro
# MODEL_EXEC_CFO=gpt-5.6-terra
# MODEL_EXEC_HR=gpt-5.4
# MODEL_EXEC_LEGAL=gpt-5.6-terra
# MODEL_EXEC_COO=gpt-5.4
# MODEL_EXEC_SECRETARY=gpt-5.4
# MODEL_EXEC_AGENDA=DeepSeek-V4-Pro
