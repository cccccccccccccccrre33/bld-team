# Скопируй в .env для локального запуска.
# Для GitHub Actions — все эти значения идут в Secrets/Variables репозитория.
# Никогда не коммить .env с реальными значениями!

# ── Azure AI Foundry ──────────────────────────────────────────────────────────
# Project endpoint (не resource endpoint!):
# Azure AI Foundry → твой проект → Overview → "Project endpoint"
FOUNDRY_PROJECT_ENDPOINT=

# Аутентификация:
# Локально: просто выполни `az login` — DefaultAzureCredential подхватит сам,
#           переменные ниже не нужны.
# GitHub Actions: нужен Service Principal (см. README — раздел GitHub Actions).
AZURE_CLIENT_ID=
AZURE_TENANT_ID=
AZURE_CLIENT_SECRET=

# ── GitHub ────────────────────────────────────────────────────────────────────
# Нужен только для main.py (код-ревью команда).
# Для main_board.py (совет директоров) не нужен.
GITHUB_TOKEN=

# ── Telegram ──────────────────────────────────────────────────────────────────
# 1. Создай бота: напиши @BotFather → /newbot → получишь токен
# 2. Напиши своему боту любое сообщение (иначе он не сможет тебе писать)
# 3. Открой в браузере: https://api.telegram.org/bot<TOKEN>/getUpdates
#    Найди "chat":{"id": ...} — это твой chat_id
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ── Модели совета (опционально) ───────────────────────────────────────────────
# Если не задано — берутся defaults из config/models.py.
# В GitHub Actions задаются как Variables (не Secrets), т.к. не секретные.
# MODEL_BOARD_MEKHMAT=o3
# MODEL_BOARD_FIZTECH=gpt-5.1
# MODEL_BOARD_FIZMAT=o3
# MODEL_BOARD_TEHMAT=gpt-5.1
# MODEL_BOARD_SECRETARY=gpt-5.4-mini
# MODEL_BOARD_AGENDA=gpt-5.4-mini

# ── Прочее ────────────────────────────────────────────────────────────────────
AI_TEAM_WORKDIR=./repos
